{
  "manifest_version": 3,
  "name": "字幕实时翻译 · DeepSeek",
  "version": "1.0.0",
  "description": "抓取网页视频自带的字幕轨，用 DeepSeek 预取翻译成中文并叠加在画面上。",
  "minimum_chrome_version": "111",

  "permissions": ["storage"],
  "host_permissions": ["https://api.deepseek.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "字幕实时翻译"
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/capture.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/settings.js",
        "content/parse.js",
        "content/overlay.js",
        "content/pipeline.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
